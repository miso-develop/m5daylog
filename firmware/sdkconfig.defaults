# M5Daylog firmware default configuration.
#
# Target: M5Capsule v1.1 (ESP32-S3FN8, 8MB flash).
# ESP-IDF pin: v5.5.5 (see firmware/README.md for acquisition steps).
# This file only carries defaults that differ from ESP-IDF Kconfig defaults
# and that are required for every clean build of this project.

CONFIG_IDF_TARGET="esp32s3"

# Keep scaffold boot output at INFO so boot / stage / result lines are
# visible over serial without enabling verbose subsystems.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Human Gate fix (Task #44): FATFS must support long filenames so the
# specified /sdcard/M5DAYLOG/recordings directory (LFN, non-8.3) creates
# successfully. Heap-based LFN workspace with 255-char max.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Human Gate fix (Task #44): M5Capsule v1.1 is ESP32-S3FN8 with 8MB flash.
# Fix the image header to 8MB; never select 2MB.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Tasks #49/#87: one composite TinyUSB device. MSC keeps exclusive microSD
# ownership; D-031 adds the minimal canonical CDC v1 RELEASE_STORAGE transport.
# Task #50 will extend this same parser/dispatcher after rebasing onto #87.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=2048
CONFIG_TINYUSB_CDC_TX_BUFSIZE=2048
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512

# Task #87: stock self-powered hardware has no dedicated firmware-readable
# VBUS sense. Suspend/bus-loss callbacks are diagnostic-only ambiguous signals;
# they never authorize release, SHUTDOWN_ARMED, remount, or recording.
CONFIG_TINYUSB_SUSPEND_CALLBACK=y
